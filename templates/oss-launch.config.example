# oss-launch headless config. Copy to oss-launch.config, fill in, then:
#   bash scripts/apply.sh <target-dir> --config oss-launch.config
#
# This is a plain shell-sourceable file (KEY="value"), not YAML/JSON, to match the
# rest of this toolkit's zero-extra-dependency scripts. Only set what you want to
# override -- everything has a sensible default except the three REQUIRED fields
# below, which can't be safely inferred or defaulted.

# --- REQUIRED (apply.sh exits with an error if these are missing) ---
AUTHOR="Jane Doe"
SECURITY_EMAIL="security@example.com"
TAGLINE="A one-line description of what this project does"

# --- Optional overrides (auto-detected or generically defaulted otherwise) ---
# LICENSE="Apache-2.0"          # or "MIT". Default: Apache-2.0
# OWNER="your-github-org"       # default: parsed from git remote
# REPO="your-repo-name"         # default: parsed from git remote, else folder name
# CONTACT_EMAIL="$SECURITY_EMAIL"  # default: same as SECURITY_EMAIL
# SITE_URL="https://example.com/"  # base URL of the published site, used by llms.txt and
#                               # the generated 404.html / robots.txt / sitemap.xml.
#                               # Default: https://<owner>.github.io/<repo>/
#                               # TRAILING SLASH REQUIRED -- robots.txt and sitemap.xml
#                               # concatenate onto it. Set this whenever the site is on a
#                               # custom domain, or the sitemap URL will be wrong.
# WANT_CITATION=false           # set true only if this repo is citable (paper/DOI)
# WANT_FUNDING=false            # set true only if you want sponsorship links

# --- Opt-in extra workflows (all default false; see references/ci-cd.md) ---
# Each is gated on a real precondition too, and apply.sh tells you when a flag was set
# but the precondition wasn't met, rather than silently writing nothing.
#
# WANT_COVERAGE=false           # Codecov upload workflow. Node and Python only, and only
#                               # when a test runner was detected. Public repos need no
#                               # token; private repos need a CODECOV_TOKEN secret.
# WANT_RELEASE_PLEASE=false     # release-please: every push to main updates a standing
#                               # release PR from Conventional Commit messages. This is an
#                               # ALTERNATIVE to scripts/release.sh, not an addition --
#                               # both own the version number and the CHANGELOG, so run
#                               # one and delete the other. Also set 'release-type' in the
#                               # generated workflow to match the project.
# WANT_CONTAINER_BUILD=false    # Build + push a container image to GHCR. Only written
#                               # when a Dockerfile or compose file was detected. Builds
#                               # on PRs, pushes only from main and tags, so a fork's PR
#                               # can never publish an image.
